*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches

# Keystore files
*.jks
*.keystore

# External native build folder
.externalNativeBuild
.cxx/

# OS generated files
Thumbs.db
.DS_Store
# Supabase credentials
app/src/main/assets/supabase_config.json
**/supabase_secrets.properties
